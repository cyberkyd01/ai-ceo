# ---- Required ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Model / cost ----
AI_CEO_MODEL=claude-opus-5
AI_CEO_EFFORT=high                 # low | medium | high | xhigh | max
AI_CEO_MAX_LLM_USD_PER_CYCLE=5     # hard stop for Claude spend inside one cycle

# ---- Autonomy policy ----
# supervised: anything that publishes externally or spends money waits in the approval queue
# autonomous: publishes automatically where an integration exists; spend still capped below
AI_CEO_AUTONOMY=supervised
AI_CEO_MONTHLY_BUDGET_USD=200      # total budget the CEO may plan against
AI_CEO_AUTO_SPEND_LIMIT_USD=0      # per-action spend allowed without approval (autonomous mode only)

# ---- Where company state lives ----
AI_CEO_HOME=./companies

# ---- Optional integrations (leave blank to route those actions to the approval queue as manual packets) ----
DEVTO_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
OUTBOUND_WEBHOOK_URL=              # Zapier / Make / n8n hook that fans out to X, LinkedIn, email, etc.
STRIPE_API_KEY=                    # read-only key is enough; used for revenue metrics

# ---- Engineering ----
AI_CEO_CODER=claude                # "claude" uses Claude Code headless (`claude -p`); "none" = issues only
AI_CEO_CODER_MAX_TURNS=80
